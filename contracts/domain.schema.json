{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "夜游生态扰动许可领域事件",
  "description": "用于跨模块交换事实记录的公共信封。业务明细放在 payload 中，信封字段保持稳定。",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "version",
    "summary"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 8,
      "description": "事件唯一标识；来源系统重试时必须沿用原标识"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "APPLICATION_SUBMITTED",
        "PERMIT_ISSUED",
        "FEEDBACK_RECEIVED",
        "CONDITION_ISSUED",
        "CONDITION_ADJUSTED",
        "SAMPLE_RECORDED",
        "RULE_VIOLATION_FLAGGED",
        "BREACH_CONFIRMED",
        "ACTIVITY_SUSPENDED",
        "RECTIFICATION_RECORDED",
        "ACTIVITY_RESUMED"
      ],
      "description": "本领域事件类型"
    },
    "aggregate_type": {
      "type": "string",
      "enum": [
        "permit_application",
        "operating_condition",
        "monitoring_sample",
        "enforcement_decision"
      ],
      "description": "业务对象类型"
    },
    "aggregate_id": {
      "type": "string",
      "minLength": 1,
      "description": "业务对象标识。许可申请为申请号；场次条件为 申请号#场次号；监测序列为 申请号#场次号#维度；处置案件为 case#申请号#场次号#维度"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time",
      "description": "事实发生时间；设备离线补报时保留采样发生的真实时间"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "description": "平台登记时间；补报事件会晚于 occurred_at"
    },
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "对象版本，按聚合从 1 开始递增"
    },
    "summary": {
      "type": "string",
      "minLength": 2,
      "description": "中文事实摘要"
    },
    "actor": {
      "type": "object",
      "description": "行为人。签发许可、确认违规、批准恢复必须是有权人员；规则提示由 system 记录",
      "properties": {
        "actor_id": { "type": "string" },
        "name": { "type": "string" },
        "kind": {
          "type": "string",
          "enum": ["officer", "organizer", "resident", "device", "system"]
        }
      }
    },
    "payload": {
      "type": "object",
      "description": "业务明细，按事件类型定义，见 README"
    }
  },
  "additionalProperties": true
}
